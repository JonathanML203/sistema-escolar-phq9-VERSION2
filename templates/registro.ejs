<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PHQ-9 | Registro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght=400;500;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Roboto', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col transition-colors duration-300">

    <nav class="w-full bg-indigo-600 text-white p-4 shadow-md">
        <div class="max-w-6xl mx-auto flex items-center justify-between px-4">
            <span class="text-lg font-bold tracking-wide flex items-center gap-2">
                <i class="bi bi-person-plus-fill"></i> Registro de Nuevo Usuario
            </span>
            <span class="text-sm opacity-80 hidden md:inline">Plataforma de Evaluación PHQ-9</span>
        </div>
    </nav>

    <div class="flex-1 flex items-center justify-center container mx-auto px-4 py-8">
        <div class="bg-white p-6 md:p-8 rounded-2xl shadow-xl border border-slate-100 max-w-3xl w-full">
            
            <% if (locals.error && error.length > 0) { %>
                <div class="flex items-center justify-between p-4 mb-6 text-sm rounded-xl border bg-red-50 text-red-800 border-red-200" role="alert">
                    <div class="flex items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span><%= error %></span>
                    </div>
                    <button type="button" class="text-red-900 font-bold hover:opacity-70" onclick="this.parentElement.remove()">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            <% } %>

            <form action="/registro" method="POST" class="space-y-5">
                
                <div class="flex flex-col gap-1.5">
                    <label class="text-sm font-bold text-slate-700">Nombre Completo*</label>
                    <input type="text" name="nombre" class="w-full p-2.5 rounded-lg border border-slate-300 bg-transparent outline-none focus:ring-2 focus:ring-indigo-500 transition-all placeholder-slate-400 text-sm" placeholder="Ej: Juan Pérez Morales" required>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="flex flex-col gap-1.5">
                        <label class="text-sm font-bold text-slate-700">Número de Control / Clave de personal*</label>
                        <input type="text" name="username" class="w-full p-2.5 rounded-lg border border-slate-300 bg-transparent outline-none focus:ring-2 focus:ring-indigo-500 transition-all placeholder-slate-400 text-sm" placeholder="Usuario de acceso" required>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label class="text-sm font-bold text-slate-700">Contraseña*</label>
                        <input type="password" name="password" class="w-full p-2.5 rounded-lg border border-slate-300 bg-transparent outline-none focus:ring-2 focus:ring-indigo-500 transition-all text-sm" required>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="flex flex-col gap-1.5">
                        <label class="text-sm font-bold text-slate-700">Género*</label>
                        <select name="genero" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white outline-none focus:ring-2 focus:ring-indigo-500 transition-all text-sm text-slate-800">
                            <option value="Masculino">Masculino</option>
                            <option value="Femenino">Femenino</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label class="text-sm font-bold text-slate-700">Carrera*</label>
                        <select name="carrera" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white outline-none focus:ring-2 focus:ring-indigo-500 transition-all text-sm text-slate-800">
                            <option value="Sistemas Computacionales">Sistemas Computacionales</option>
                            <option value="Electronica">Electrónica</option>
                            <option value="Mecanica">Mecánica</option>
                            <option value="Industrial">Industrial</option>
                            <option value="Gestion Empresarial">Gestión Empresarial</option>
                            <option value="Contador Publico">Contador Público</option>
                            <option value="Logistica">Logística</option>
                        </select>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label class="text-sm font-bold text-slate-700">Semestre*</label>
                        <select name="semestre" id="selectSemestre" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white outline-none focus:ring-2 focus:ring-indigo-500 transition-all text-sm text-slate-800">
                            <option value="PRIMERO">PRIMERO</option>
                            <option value="SEGUNDO">SEGUNDO</option>
                            <option value="TERCERO">TERCERO</option>
                            <option value="CUARTO">CUARTO</option>
                            <option value="QUINTO">QUINTO</option>
                            <option value="SEXTO">SEXTO</option>
                            <option value="SEPTIMO">SEPTIMO</option>
                            <option value="OCTAVO">OCTAVO</option>
                            <option value="NOVENO">NOVENO</option>
                            <option value="DECIMO">DECIMO</option>
                            <option value="ONCEAVO">ONCEAVO</option>
                            <option value="DOCEAVO">DOCEAVO</option>
                            <option value="No Aplica">No Aplica</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="flex flex-col gap-1.5">
                        <label class="text-sm font-bold text-slate-700">Fecha de Nacimiento*</label>
                        <div class="grid grid-cols-3 gap-1">
                            <select name="dia_nacimiento" class="p-2 text-xs rounded-lg border border-slate-300 bg-white outline-none focus:ring-2 focus:ring-indigo-500">
                                <% for(let d=1; d<=31; d++) { %>
                                    <option value="<%= d %>"><%= d %></option>
                                <% } %>
                            </select>
                            <select name="mes_nacimiento" class="p-2 text-xs rounded-lg border border-slate-300 bg-white outline-none focus:ring-2 focus:ring-indigo-500">
                                <% const meses = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"]; %>
                                <% meses.forEach((m, idx) => { %>
                                    <option value="<%= m %>"><%= m %></option>
                                <% }); %>
                            </select>
                            <select name="anio_nacimiento" class="p-2 text-xs rounded-lg border border-slate-300 bg-white outline-none focus:ring-2 focus:ring-indigo-500">
                                <% for(let a=2012; a>=1960; a--) { %>
                                    <option value="<%= a %>"><%= a %></option>
                                <% } %>
                            </select>
                        </div>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label class="text-sm font-bold text-slate-700">Colonia (Veracruz)*</label>
                        <input type="text" name="colonia" class="w-full p-2.5 rounded-lg border border-slate-300 bg-transparent outline-none focus:ring-2 focus:ring-indigo-500 transition-all placeholder-slate-400 text-sm" placeholder="Tu colonia" required>
                    </div>
                    <div class="flex flex-col gap-1.5">
                        <label class="text-sm font-bold text-slate-700">Nivel Socioeconómico*</label>
                        <select name="estatus" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white outline-none focus:ring-2 focus:ring-indigo-500 transition-all text-sm text-slate-800">
                            <option value="Bajo">Bajo</option>
                            <option value="Medio">Medio</option>
                            <option value="Alto">Alto</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
                    <div class="flex flex-col gap-1.5">
                        <label class="text-sm font-bold text-slate-700">¿Quién eres?</label>
                        <select name="rol" id="selectRol" onchange="evaluarRolDocente(this.value)" class="w-full p-2.5 rounded-lg border border-slate-300 bg-white outline-none focus:ring-2 focus:ring-indigo-500 transition-all text-sm text-slate-800">
                            <option value="alumno">Soy Alumno</option>
                            <option value="maestro">Soy Maestro / Administrador</option>
                            <option value="psicologo">Soy Psicólogo / Orientador</option>
                        </select>
                    </div>

                    <div id="boxClaveMaestro" class="hidden flex flex-col gap-1.5 animate-fadeIn">
                        <label class="text-sm font-bold text-amber-700 flex items-center gap-1">
                            <i class="bi bi-key-fill"></i> Clave de Validación Docente*
                        </label>
                        <input type="password" name="clave_maestro" id="inputClaveMaestro" class="w-full p-2.5 rounded-lg border border-amber-400 bg-amber-50/30 outline-none focus:ring-2 focus:ring-amber-500 transition-all text-sm" placeholder="Introduce la clave de registro">
                    </div>
                </div>

                <div class="pt-4">
                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold p-3 rounded-xl shadow-lg hover:shadow-xl transition-all tracking-widest text-sm uppercase">
                        CREAR CUENTA
                    </button>
                </div>
            </form>

            <div class="text-center mt-6 pt-4 border-t border-slate-100">
                <p class="text-sm text-slate-600">
                    ¿Ya tienes cuenta? 
                    <a href="/" class="text-indigo-600 hover:text-indigo-800 font-medium no-underline transition-colors ml-1">
                        Inicia sesión aquí
                    </a>
                </p>
            </div>

        </div>
    </div>

    <footer class="w-full bg-white border-t border-slate-200 py-4 text-center text-xs text-slate-400 font-medium mt-10">
        Área de Orientación Educativa &copy; 2026
    </footer>

    <script>
        function evaluarRolDocente(rol) {
            const boxClave = document.getElementById('boxClaveMaestro');
            const inputClave = document.getElementById('inputClaveMaestro');
            const selectSemestre = document.getElementById('selectSemestre');

            // 🌟 SE MODIFICÓ: Si es maestro O psicólogo se exige la clave y se anula el semestre académico
            if (rol === 'maestro' || rol === 'psicologo') {
                boxClave.classList.remove('hidden');
                inputClave.required = true;
                selectSemestre.value = "No Aplica";
            } else {
                boxClave.classList.add('hidden');
                inputClave.required = false;
                inputClave.value = "";
                selectSemestre.value = "PRIMERO";
            }
        }
    </script>
</body>
</html>