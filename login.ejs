<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PHQ-9 | Inicio de Sesión</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght=400;500;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Roboto', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col transition-colors duration-300">

    <nav class="w-full bg-indigo-600 text-white p-4 shadow-md">
        <div class="max-w-6xl mx-auto flex items-center justify-between px-4">
            <span class="text-lg font-bold tracking-wide flex items-center gap-2">
                <i class="bi bi-shield-lock-fill"></i> Sistema de Evaluación PHQ-9
            </span>
            <span class="text-sm opacity-80 hidden md:inline">Acceso Seguro</span>
        </div>
    </nav>

    <div class="flex-1 flex items-center justify-center container mx-auto px-4 py-12">
        <div class="bg-white p-6 md:p-8 rounded-2xl shadow-xl border border-slate-100 max-w-md w-full">
            
            <div class="text-center mb-6">
                <h3 class="text-2xl font-bold text-slate-800">Bienvenido</h3>
                <p class="text-sm text-slate-500 mt-1">Ingresa tus credenciales para continuar</p>
            </div>

            <% if (locals.error && error.length > 0) { %>
                <div class="flex items-center justify-between p-4 mb-4 text-sm rounded-xl border bg-red-50 text-red-800 border-red-200" role="alert">
                    <div class="flex items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span><%= error %></span>
                    </div>
                    <button type="button" class="text-red-900 font-bold hover:opacity-70" onclick="this.parentElement.remove()">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            <% } %>

            <% if (locals.success && success.length > 0) { %>
                <div class="flex items-center justify-between p-4 mb-4 text-sm rounded-xl border bg-green-50 text-green-800 border-green-200" role="alert">
                    <div class="flex items-center gap-2">
                        <i class="bi bi-check-circle-fill"></i>
                        <span><%= success %></span>
                    </div>
                    <button type="button" class="text-green-900 font-bold hover:opacity-70" onclick="this.parentElement.remove()">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            <% } %>

            <form action="/login" method="POST" class="space-y-5">
                
                <div class="flex flex-col gap-1.5">
                    <label class="text-sm font-bold text-slate-700">Número de Control / Usuario</label>
                    <input type="text" name="username" class="w-full p-3 rounded-lg border border-slate-300 bg-transparent outline-none focus:ring-2 focus:ring-indigo-500 transition-all placeholder-slate-400" placeholder="Ej: 226Z0184" required>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label class="text-sm font-bold text-slate-700">Contraseña</label>
                    <input type="password" name="password" class="w-full p-3 rounded-lg border border-slate-300 bg-transparent outline-none focus:ring-2 focus:ring-indigo-500 transition-all" required>
                </div>

                <div class="flex flex-col gap-1.5">
                    <label class="text-sm font-bold text-slate-700">Tipo de Usuario</label>
                    <select name="rol" class="w-full p-3 rounded-lg border border-slate-300 bg-white outline-none focus:ring-2 focus:ring-indigo-500 transition-all text-slate-800">
                        <option value="alumno">Alumno</option>
                        <option value="maestro">Maestro / Administrador</option>
                        <!-- 🌟 SE AÑADIÓ: Opción para el nuevo perfil de orientación clínica -->
                        <option value="psicologo">Psicólogo / Orientador</option>
                    </select>
                </div>

                <div class="pt-2">
                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold p-3 rounded-xl shadow-lg hover:shadow-xl transition-all tracking-widest text-sm uppercase">
                        INGRESAR
                    </button>
                </div>
            </form>

            <div class="text-center mt-6 pt-4 border-t border-slate-100">
                <p class="text-sm text-slate-600">
                    ¿No tienes cuenta? 
                    <a href="/registro" class="text-indigo-600 hover:text-indigo-800 font-medium no-underline transition-colors ml-1">
                        Regístrate aquí
                    </a>
                </p>
            </div>

        </div>
    </div>

</body>
</html>