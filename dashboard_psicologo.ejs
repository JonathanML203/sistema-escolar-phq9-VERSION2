<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PHQ-9 | Panel Psicológico</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Roboto', sans-serif; }</style>
</head>
<body class="bg-slate-50 min-h-screen">

    <nav class="bg-white border-b border-slate-200 px-6 py-4 flex justify-between items-center sticky top-0 z-50 shadow-sm">
        <div class="flex items-center gap-2.5">
            <div class="bg-indigo-600 text-white p-2 rounded-lg shadow-md shadow-indigo-100">
                <i class="bi bi-heart-pulse-fill text-lg"></i>
            </div>
            <div>
                <h1 class="text-lg font-bold text-slate-800 leading-tight">Módulo de Orientación Psicológica</h1>
                <p class="text-xs text-slate-500">Ecosistema de Monitoreo de Salud Mental</p>
            </div>
        </div>
        <a href="/logout" class="flex items-center gap-1.5 text-xs font-bold text-red-600 hover:text-red-700 bg-red-50 hover:bg-red-100 px-3 py-2 rounded-lg transition-colors no-underline">
            <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
        </a>
    </nav>

    <main class="max-w-7xl mx-auto p-4 md:p-6 lg:p-8 space-y-6">
        
        <div class="bg-gradient-to-r from-indigo-800 to-indigo-900 rounded-2xl p-6 text-white shadow-lg space-y-2">
            <h2 class="text-xl md:text-2xl font-bold">Bienvenido al Panel Clínico</h2>
            <p class="text-indigo-200 text-sm max-w-2xl">
                Los expedientes se ordenan automáticamente priorizando los indicadores de riesgo crítico detectados por el modelo predictivo de IA.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% if (alumnos.length === 0) { %>
                <div class="col-span-full bg-white border border-slate-200 rounded-2xl p-12 text-center text-slate-400 space-y-3">
                    <i class="bi bi-folder-x text-4xl block text-slate-300"></i>
                    <p class="text-sm font-medium">No hay alumnos matriculados bajo evaluación actualmente.</p>
                </div>
            <% } else { %>
                <% alumnos.forEach(alumno => { %>
                    
                    <div class="bg-white rounded-2xl shadow-sm border p-5 flex flex-col justify-between space-y-5 transition-all hover:shadow-md
                        <%= alumno.q9 >= 2 ? 'border-red-200 bg-red-50/10' : (alumno.puntaje >= 2 ? 'border-amber-200 bg-amber-50/10' : 'border-slate-100') %>">
                        
                        <div class="space-y-3">
                            <div class="flex justify-between items-start gap-2">
                                <div>
                                    <h3 class="font-bold text-slate-800 text-base leading-tight"><%= alumno.nombre %></h3>
                                    <p class="text-xs font-medium text-slate-400 mt-0.5">Matrícula: <span class="text-slate-600 font-semibold"><%= alumno.username %></span></p>
                                </div>

                                <% if (alumno.q9 >= 2) { %>
                                    <span class="animate-pulse flex items-center gap-1 bg-red-600 text-white text-[10px] font-extrabold px-2 py-1 rounded-md shadow shadow-red-200 uppercase tracking-wider shrink-0">
                                        <i class="bi bi-exclamation-octagon-fill"></i> Riesgo Mayor
                                    </span>
                                <% } else if (alumno.puntaje >= 2) { %>
                                    <span class="flex items-center gap-1 bg-amber-500 text-white text-[10px] font-extrabold px-2 py-1 rounded-md uppercase tracking-wider shrink-0">
                                        <i class="bi bi-exclamation-triangle-fill"></i> Alerta IA
                                    </span>
                                <% } %>
                            </div>

                            <div class="grid grid-cols-2 gap-2 bg-slate-50 p-2.5 rounded-xl border border-slate-100 text-[11px] text-slate-600">
                                <p><b class="text-slate-400 uppercase text-[9px] block">Carrera:</b> <%= alumno.carrera %></p>
                                <p><b class="text-slate-400 uppercase text-[9px] block">Semestre:</b> <%= alumno.semestre %>° Semestre</p>
                            </div>
                        </div>

                        <hr class="border-slate-100">

                        <div class="space-y-4 flex-grow">
                            <div class="space-y-1">
                                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Estatus de Intervención</label>
                                <select id="estado-<%= alumno.id %>" class="w-full bg-white border border-slate-200 rounded-xl p-2 text-xs font-medium text-slate-700 shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all">
                                    <option value="Pendiente de Cita" <%= alumno.estado === 'Pendiente de Cita' ? 'selected' : '' %>>🟡 Pendiente de Cita</option>
                                    <option value="En Canalización / Proceso" <%= alumno.estado === 'En Canalización / Proceso' ? 'selected' : '' %>>🔵 En Canalización / Proceso</option>
                                    <option value="Caso Cerrado / Atendido" <%= alumno.estado === 'Caso Cerrado / Atendido' ? 'selected' : '' %>>🟢 Caso Cerrado / Atendido</option>
                                </select>
                            </div>

                            <div class="space-y-1">
                                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-wider">Bitácora Clínica (Confidencial)</label>
                                <textarea id="notas-<%= alumno.id %>" placeholder="Escribe observaciones clínicas confidenciales aquí..." 
                                    class="w-full border border-slate-200 rounded-xl p-2.5 text-xs text-slate-600 shadow-sm h-24 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 outline-none transition-all resize-none"><%= alumno.notas_clinicas %></textarea>
                            </div>
                        </div>

                        <button onclick="guardarExpediente(<%= alumno.id %>)" 
                            class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 px-4 rounded-xl shadow-md shadow-indigo-100 transition-colors flex items-center justify-center gap-1.5 text-xs tracking-wide uppercase">
                            <i class="bi bi-folder-check text-sm"></i> Guardar Expediente
                        </button>
                    </div>

                <% }) %>
            <% } %>
        </div>
    </main>

    <script>
        function guardarExpediente(usuarioId) {
            const estadoSelect = document.getElementById(`estado-${usuarioId}`).value;
            const notasTextarea = document.getElementById(`notas-${usuarioId}`).value;

            // Petición asíncrona hacia la nueva ruta de Node.js
            fetch('/psicologo/actualizar_estatus', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    usuario_id: usuarioId,
                    estado: estadoSelect,
                    notas_clinicas: notasTextarea
                })
            })
            .then(response => {
                if (!response.ok) throw new Error();
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    alert("✅ Registro guardado e indexado en el historial clínico correctamente.");
                    window.location.reload(); // Recarga para reordenar según el nuevo estatus si aplica
                } else {
                    alert("❌ Error de permisos: No se pudo actualizar el expediente.");
                }
            })
            .catch(error => {
                console.error(error);
                alert("⚠️ Error de enlace: No hay comunicación con el servidor central.");
            });
        }
    </script>
</body>
</html>